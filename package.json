{
  "name": "saas-starter-kit",
  "version": "1.6.0",
  "private": true,
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "scripts": {
    "release": "git checkout release && git merge origin/main && release-it && git checkout main && git merge origin/release && git push origin main",
    "dev": "next dev --port 4002",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start --port 4002",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint -c eslint.config.cjs ./",
    "check-unused": "npx knip",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run build",
    "playwright:update": "playwright install && playwright install-deps",
    "test:e2e": "playwright test -x",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --env=jsdom",
    "build-ci": "next build",
    "sync-stripe": "node --env-file .env sync-stripe.js",
    "check-locale": "node check-locale.js",
    "delete-team": "node --env-file .env delete-team.js"
  },
  "dependencies": {
    "@boxyhq/metrics": "0.2.15",
    "@boxyhq/react-ui": "3.5.3",
    "@boxyhq/saml-jackson": "26.2.0",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@retracedhq/logs-viewer": "2.10.1",
    "@retracedhq/retraced": "0.7.23",
    "@sentry/nextjs": "10.70.0",
    "@tailwindcss/typography": "0.5.20",
    "bcryptjs": "3.0.3",
    "classnames": "2.5.1",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "formik": "2.4.9",
    "i18next": "25.10.9",
    "micromatch": "4.0.8",
    "mixpanel-browser": "2.82.0",
    "next": "15.5.14",
    "next-auth": "4.24.15",
    "next-i18next": "15.4.3",
    "nodemailer": "7.0.11",
    "react": "18.3.1",
    "react-daisyui": "5.0.5",
    "react-dom": "18.3.1",
    "react-email": "6.9.2",
    "react-google-recaptcha": "3.1.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "15.5.3",
    "sharp": "0.35.3",
    "slack-notify": "2.0.7",
    "stripe": "22.5.0",
    "svix": "1.99.1",
    "swr": "2.5.1",
    "yup": "1.7.1",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/jest": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/mixpanel-browser": "2.66.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "7.0.4",
    "@types/react": "18.3.13",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.5.4",
    "daisyui": "4.12.24",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.14",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "globals": "16.5.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.10.0",
    "release-it": "21.0.2",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typeorm": {
      "mssql": ">=11.0.0"
    },
    "react-email": {
      "esbuild": ">=0.25.0",
      "next": ">=15.2.3"
    },
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}
